<Project>

  <!--
    Central package management: every version is declared once, here.
    Projects reference packages without versions.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Windows platform">
    <!-- Version validated by the window-behaviour spike (issue #2). The spikes still use the whole SDK. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!--
      ADR-008: Noto references only the parts of Windows App SDK 2.5.1 it uses, at that release's versions, so the
      installer does not carry its AI, machine-learning, search and widgets libraries (about 50 MB Noto never loads).
      Runtime is that release's version check over the parts.
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup Label="Packaging">
    <!--
      ADR-008: installed, uninstalled and upgraded by Velopack (MIT). The vpk tool that packs a release is pinned to the
      same version in .config/dotnet-tools.json. v0.1 never checks for updates (no network access, quality-gates.md).
    -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!--
      ADR-003: Microsoft.Data.Sqlite, no ORM.

      Dapper was referenced in anticipation of #13 and never used. Removed
      after evaluation: 5 tables, 26 flat columns, one join. Dapper would
      remove reader boilerplate at the cost of a dependency and an indirection
      at the layer where seeing the row-to-domain mapping is still worth more.
      Reversible — revisit if #13's mapping code proves genuinely repetitive.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <!--
    Deliberately NOT here yet, each with the issue that introduces it:
      a markdown renderer             -> #14  (ADR-004)
      a tray-icon library             -> M2
    Principle 9: a dependency arrives when a feature needs it, not before.
  -->

</Project>
