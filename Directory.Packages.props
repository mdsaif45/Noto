<Project>

  <!--
    Central package management: every version is declared once, here.
    Projects reference packages without versions.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Windows platform">
    <!-- Version validated by the window-behaviour spike (issue #2). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- ADR-003: Microsoft.Data.Sqlite + Dapper, no ORM. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!--
    Deliberately NOT here yet, each with the issue that introduces it:
      a markdown renderer             -> #14  (ADR-004)
      a tray-icon library             -> M2
    Principle 9: a dependency arrives when a feature needs it, not before.
  -->

</Project>
