<UserControl
    x:Class="Noto.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto"
    AutomationProperties.AutomationId="SearchRoot"
    AutomationProperties.Name="Search">

    <!--
        Search (ADR-018 §3): a workspace surface like Settings and the Recycle Bin, built when opened and released when
        left. The box keeps the keyboard: typing searches, Up and Down move through the results, Enter opens one.
        Matches are marked with a text highlighter in the search-match tokens. Every visual value is a token.
    -->
    <Grid Background="{ThemeResource SurfaceSidebarBrush}"
          Padding="{StaticResource PanePadding}"
          RowSpacing="{StaticResource SpaceS}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceXS}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SearchBackButton"
                Style="{StaticResource HeaderButtonStyle}"
                Click="OnBackClick"
                ToolTipService.ToolTip="Close search"
                AutomationProperties.Name="Close search">
                <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSize}" />
            </Button>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Style="{StaticResource FolderNameInputStyle}"
                PlaceholderText="Search notes and folders"
                IsSpellCheckEnabled="False"
                TextChanged="OnQueryChanged"
                PreviewKeyDown="OnBoxPreviewKeyDown"
                AutomationProperties.Name="Search notes and folders"
                AutomationProperties.HelpText="Up and Down choose a result, Enter opens it, Control+C copies it" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">
            <CheckBox
                x:Name="ScopeToggle"
                Visibility="Collapsed"
                Checked="OnScopeChanged"
                Unchecked="OnScopeChanged" />
            <!-- No static name: the message is the name, announced as it changes. -->
            <TextBlock
                x:Name="SearchStatus"
                Style="{StaticResource FolderPaneGuidanceStyle}"
                local:Accessible.Announces="True"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <ListView
            x:Name="ResultList"
            Grid.Row="2"
            ItemsSource="{x:Bind Results}"
            ItemContainerStyle="{StaticResource NoteRowStyle}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnResultClick"
            PreviewKeyDown="OnListPreviewKeyDown"
            AutomationProperties.Name="Search results">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResultItem">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis">
                            <TextBlock.TextHighlighters>
                                <TextHighlighter Background="{ThemeResource SearchMatchBrush}" Foreground="{ThemeResource SearchMatchTextBrush}" />
                            </TextBlock.TextHighlighters>
                        </TextBlock>
                        <TextBlock Text="{x:Bind Snippet}" Visibility="{x:Bind SnippetVisibility}" FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis">
                            <TextBlock.TextHighlighters>
                                <TextHighlighter Background="{ThemeResource SearchMatchBrush}" Foreground="{ThemeResource SearchMatchTextBrush}" />
                            </TextBlock.TextHighlighters>
                        </TextBlock>
                        <TextBlock Text="{x:Bind Where}" FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</UserControl>
