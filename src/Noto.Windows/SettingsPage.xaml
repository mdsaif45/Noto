<UserControl
    x:Class="Noto.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto"
    AutomationProperties.AutomationId="SettingsRoot"
    AutomationProperties.Name="Settings">

    <!--
        The settings surface (Slice 1, parity J table): the workspace's fourth
        surface, inside the drawer, opened from the header, Ctrl+, or the tray.
        One scrolling page, six sections; no navigation view, no second window.

        Every control is WinUI's own (ToggleSwitch, ComboBox, Button), styled by
        the design system, so each has Noto's states in Light, Dark and High
        Contrast and the same focus ring. Every visual value is a token. Tab
        order is document order, which is the visual order.

        Every setting is one row (SettingRowStyle): its name, and what it does,
        on the left; its control at the row's right edge, vertically centred,
        so the controls of every group line up in one column.

        Created only when Settings is first opened, and released when it is
        left: the tree costs nothing while it is not on screen.
    -->

    <Grid x:Name="SettingsLayout"
          Background="{ThemeResource SurfaceSidebarBrush}"
          Padding="{StaticResource PanePadding}"
          RowSpacing="{StaticResource SpaceS}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
            <Button
                x:Name="SettingsBackButton"
                Style="{StaticResource HeaderButtonStyle}"
                Click="OnBackClick"
                ToolTipService.ToolTip="Back"
                AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSize}" />
            </Button>
            <TextBlock
                Text="Settings"
                Style="{StaticResource SurfaceTitleStyle}"
                AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>

        <!-- A setting that could not be saved. The text is the name; announced when it appears. -->
        <TextBlock
            x:Name="SettingsNoticeText"
            Grid.Row="1"
            Style="{StaticResource FolderPaneNoticeStyle}"
            Visibility="Collapsed"
            local:Accessible.Announces="True"
            AutomationProperties.LiveSetting="Assertive" />

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="{StaticResource ScrollBarGutter}">
            <StackPanel Spacing="{StaticResource SpaceXL}">

                <!-- GENERAL -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="General" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Start Noto with Windows" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock
                                        x:Name="LaunchAtLoginNote"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="OpenStartupAppsButton"
                                        Style="{StaticResource SettingSubtleButtonStyle}"
                                        Content="Open Startup apps"
                                        Visibility="Collapsed"
                                        Click="OnOpenStartupAppsClick"
                                        AutomationProperties.Name="Open Startup apps in Windows Settings" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="LaunchAtLoginSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnLaunchAtLoginToggled"
                                    AutomationProperties.Name="Start Noto with Windows"
                                    AutomationProperties.HelpText="Starts Noto hidden when you sign in." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Hide when I click elsewhere" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Unless Keep Noto open is on." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="HideOnDeactivationSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnHideOnDeactivationToggled"
                                    AutomationProperties.Name="Hide when I click elsewhere"
                                    AutomationProperties.HelpText="Unless Keep Noto open is on." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Open with a single click" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Folders. Otherwise, double-click. A note is edited with one click either way." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="SingleClickSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnSingleClickToggled"
                                    AutomationProperties.Name="Open with a single click"
                                    AutomationProperties.HelpText="Folders. Otherwise, double-click. A note is edited with one click either way." />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SIDEBAR -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Sidebar" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Side" Style="{StaticResource SettingLabelStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="SideSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingComboBoxStyle}"
                                    SelectionChanged="OnSideChanged"
                                    AutomationProperties.Name="Side">
                                    <ComboBoxItem Content="Right" Tag="Right" />
                                    <ComboBoxItem Content="Left" Tag="Left" />
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Escape key" Style="{StaticResource SettingLabelStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="EscapeSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingComboBoxStyle}"
                                    SelectionChanged="OnEscapeChanged"
                                    AutomationProperties.Name="Escape key">
                                    <ComboBoxItem Content="Go back, then hide" Tag="LeaveFolderOrHide" />
                                    <ComboBoxItem Content="Go back only" Tag="LeaveFolder" />
                                    <ComboBoxItem Content="Hide Noto" Tag="Hide" />
                                    <ComboBoxItem Content="Do nothing" Tag="None" />
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- APPEARANCE -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="High contrast, when on in Windows, is used instead." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingComboBoxStyle}"
                                    SelectionChanged="OnThemeChanged"
                                    AutomationProperties.Name="Theme"
                                    AutomationProperties.HelpText="High contrast, when on in Windows, is used instead.">
                                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </Grid>

                            <!-- F13 (#154): the note text's family and size (D47, D48, J12, J13). -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Font" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="For notes, as you read and write them." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="NoteFontSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingComboBoxStyle}"
                                    SelectionChanged="OnNoteFontChanged"
                                    AutomationProperties.Name="Font"
                                    AutomationProperties.HelpText="For notes, as you read and write them.">
                                    <ComboBoxItem Content="Default" Tag="" />
                                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                                    <ComboBoxItem Content="Calibri" Tag="Calibri" />
                                    <ComboBoxItem Content="Cambria" Tag="Cambria" />
                                    <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                    <ComboBoxItem Content="Verdana" Tag="Verdana" />
                                    <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Text size" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Ctrl+= and Ctrl+- change it from anywhere in Noto." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="NoteSizeSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingComboBoxStyle}"
                                    SelectionChanged="OnNoteSizeChanged"
                                    AutomationProperties.Name="Text size"
                                    AutomationProperties.HelpText="Ctrl+= and Ctrl+- change it from anywhere in Noto.">
                                    <ComboBoxItem Content="10" Tag="10" />
                                    <ComboBoxItem Content="11" Tag="11" />
                                    <ComboBoxItem Content="12" Tag="12" />
                                    <ComboBoxItem Content="13" Tag="13" />
                                    <ComboBoxItem Content="14" Tag="14" />
                                    <ComboBoxItem Content="15" Tag="15" />
                                    <ComboBoxItem Content="16" Tag="16" />
                                    <ComboBoxItem Content="18" Tag="18" />
                                    <ComboBoxItem Content="20" Tag="20" />
                                    <ComboBoxItem Content="22" Tag="22" />
                                    <ComboBoxItem Content="24" Tag="24" />
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Formatting toolbar" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Above selected text in a note. The keys and the Format menu work either way." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="FormatToolbarSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnFormatToolbarToggled"
                                    AutomationProperties.Name="Formatting toolbar"
                                    AutomationProperties.HelpText="Above selected text in a note. The keys and the Format menu work either way." />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SHORTCUTS -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Shortcuts" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Show and hide Noto" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="HotkeyChordText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="HotkeyEnabledSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnHotkeyEnabledToggled"
                                    AutomationProperties.Name="Show and hide Noto with a shortcut" />
                            </Grid>

                            <!--
                                The recorder (Slice 1, parity G50): select it, press the new chord. While it listens it
                                owns the keyboard, Escape or leaving it cancels, and Noto's own chord is held but
                                ignored, so pressing it cannot hide this page. The status line announces each step.
                            -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Shortcut" Style="{StaticResource SettingLabelStyle}" />
                                    <!-- Each step of recording, and how it ended. The text is the name; announced when it changes. -->
                                    <TextBlock
                                        x:Name="HotkeyRecorderStatus"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                    <!-- Why the shortcut is not active. The text is the name; announced when it appears. -->
                                    <TextBlock
                                        x:Name="HotkeyMessage"
                                        Style="{StaticResource FolderPaneNoticeStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                                <Button
                                    x:Name="HotkeyRecorder"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Click="OnRecorderClick"
                                    PreviewKeyDown="OnRecorderKeyDown"
                                    LostFocus="OnRecorderLostFocus"
                                    ProcessKeyboardAccelerators="OnRecorderAccelerators"
                                    AutomationProperties.Name="Change the show and hide shortcut"
                                    AutomationProperties.HelpText="Select, then press the new shortcut. It needs Ctrl, Alt or Win, and a letter, digit, F1 to F24 or Space. Escape cancels." />
                            </Grid>

                            <!--
                                F17 (#156, parity B2, G2): a second global shortcut, Noto shown with a new note ready to
                                type in. Off by default (principle 7); recorded as the show and hide shortcut is.
                            -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="New note" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="NewNoteHotkeyChordText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="NewNoteHotkeySetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnNewNoteHotkeyToggled"
                                    AutomationProperties.Name="Make a new note with a shortcut"
                                    AutomationProperties.HelpText="From any app: Noto opens with a new note ready to type in." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="New note shortcut" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock
                                        x:Name="NewNoteHotkeyRecorderStatus"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                    <TextBlock
                                        x:Name="NewNoteHotkeyMessage"
                                        Style="{StaticResource FolderPaneNoticeStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                                <Button
                                    x:Name="NewNoteHotkeyRecorder"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Click="OnRecorderClick"
                                    PreviewKeyDown="OnRecorderKeyDown"
                                    LostFocus="OnRecorderLostFocus"
                                    ProcessKeyboardAccelerators="OnRecorderAccelerators"
                                    AutomationProperties.Name="Change the new note shortcut"
                                    AutomationProperties.HelpText="Select, then press the new shortcut. It needs Ctrl, Alt or Win, and a letter, digit, F1 to F24 or Space. Escape cancels." />
                            </Grid>

                            <!--
                                F18 (#157, parity B3, D43, G4): a third global shortcut, Noto shown with a new note holding
                                the clipboard's text or picture. Off by default; recorded as the others are.
                            -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="New note from clipboard" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ClipboardNoteHotkeyChordText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ClipboardNoteHotkeySetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnClipboardNoteHotkeyToggled"
                                    AutomationProperties.Name="Make a note from the clipboard with a shortcut"
                                    AutomationProperties.HelpText="From any app: Noto opens with a new note holding the copied text or picture." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="New note from clipboard shortcut" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock
                                        x:Name="ClipboardNoteHotkeyRecorderStatus"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                    <TextBlock
                                        x:Name="ClipboardNoteHotkeyMessage"
                                        Style="{StaticResource FolderPaneNoticeStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                                <Button
                                    x:Name="ClipboardNoteHotkeyRecorder"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Click="OnRecorderClick"
                                    PreviewKeyDown="OnRecorderKeyDown"
                                    LostFocus="OnRecorderLostFocus"
                                    ProcessKeyboardAccelerators="OnRecorderAccelerators"
                                    AutomationProperties.Name="Change the new note from clipboard shortcut"
                                    AutomationProperties.HelpText="Select, then press the new shortcut. It needs Ctrl, Alt or Win, and a letter, digit, F1 to F24 or Space. Escape cancels." />
                            </Grid>

                            <!--
                                F21 (#159, parity E2, G3): a fourth global shortcut, Noto shown with Search open. Off by
                                default; recorded as the others are.
                            -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Search" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="SearchHotkeyChordText" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="SearchHotkeySetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnSearchHotkeyToggled"
                                    AutomationProperties.Name="Search notes with a shortcut"
                                    AutomationProperties.HelpText="From any app: Noto opens with Search ready to type in." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Search shortcut" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock
                                        x:Name="SearchHotkeyRecorderStatus"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                    <TextBlock
                                        x:Name="SearchHotkeyMessage"
                                        Style="{StaticResource FolderPaneNoticeStyle}"
                                        Visibility="Collapsed"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                                <Button
                                    x:Name="SearchHotkeyRecorder"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Click="OnRecorderClick"
                                    PreviewKeyDown="OnRecorderKeyDown"
                                    LostFocus="OnRecorderLostFocus"
                                    ProcessKeyboardAccelerators="OnRecorderAccelerators"
                                    AutomationProperties.Name="Change the search shortcut"
                                    AutomationProperties.HelpText="Select, then press the new shortcut. It needs Ctrl, Alt or Win, and a letter, digit, F1 to F24 or Space. Escape cancels." />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DATA -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Data" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Data folder" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Where Noto keeps your notes and settings." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="RevealDataFolderButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Open in Explorer"
                                    Click="OnRevealDataFolderClick"
                                    AutomationProperties.Name="Open the data folder in Explorer" />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Back up" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Save every note, folder, picture and setting to one file." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="BackupButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Back up…"
                                    Click="OnBackupClick"
                                    AutomationProperties.Name="Back up everything to a file" />
                            </Grid>

                            <!-- F15 (#15): a backup a day, the last seven kept, into the data folder's backups. -->
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Back up automatically" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Once a day, into the data folder's backups. The last 7 are kept." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutomaticBackupSetting"
                                    Grid.Column="1"
                                    Style="{StaticResource SettingToggleSwitchStyle}"
                                    Toggled="OnAutomaticBackupToggled"
                                    AutomationProperties.Name="Back up automatically"
                                    AutomationProperties.HelpText="Once a day, into the data folder's backups. The last 7 are kept." />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Restore" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Replace everything with a backup. What is here now is saved first." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="RestoreButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Restore…"
                                    Click="OnRestoreClick"
                                    AutomationProperties.Name="Restore from a backup" />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Export" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Save every note as a Markdown file, with its pictures." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="ExportButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Export…"
                                    Click="OnExportClick"
                                    AutomationProperties.Name="Export all notes as Markdown" />
                            </Grid>

                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Import" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Add Markdown files and their pictures from a folder." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="ImportButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Import…"
                                    Click="OnImportClick"
                                    AutomationProperties.Name="Import Markdown from a folder" />
                            </Grid>

                            <!--
                                The work in progress and its result (ADR-020 §6): a bar that says how far, the step in words,
                                and Cancel. Announced politely; a failure is the page's notice line, above.
                            -->
                            <Grid x:Name="DataProgress" Style="{StaticResource SettingRowStyle}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="DataStatusText"
                                        Style="{StaticResource SettingDescriptionStyle}"
                                        local:Accessible.Announces="True"
                                        AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar
                                        x:Name="DataProgressBar"
                                        Maximum="1"
                                        AutomationProperties.Name="Progress" />
                                </StackPanel>
                                <Button
                                    x:Name="DataCancelButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Cancel"
                                    Click="OnDataCancelClick"
                                    AutomationProperties.Name="Cancel" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- HELP -->
                <StackPanel Spacing="{StaticResource SpaceS}">
                    <TextBlock Text="Help" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="{StaticResource SpaceM}">
                            <Grid Style="{StaticResource SettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource SpaceXS}" VerticalAlignment="Center">
                                    <TextBlock Text="Welcome tour" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock Text="Four short steps: showing Noto, folders, writing, your data." Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="ShowWelcomeButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingButtonStyle}"
                                    Content="Show tour"
                                    Click="OnShowWelcomeClick"
                                    AutomationProperties.Name="Show the welcome tour" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
