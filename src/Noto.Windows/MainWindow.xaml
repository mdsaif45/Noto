<Window
    x:Class="Noto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto"
    Title="Noto">

    <!--
        The workspace: the folder pane (M2-1) and the note stack (ADR-016),
        under one header. Every colour, spacing, radius and
        type value below comes from a semantic token of the design system
        (ADR-011); there is no literal visual value in this file.

        The window around it is the #16 drawer, owned by App.xaml.cs and
        WindowCoordinator: docked to an edge, topmost while shown, toggled by
        the global hotkey, put away by Ctrl+W, Escape or losing activation.
    -->

    <!--
        The workspace host. Exactly one surface is visible at a time
        (replacing navigation, C1): the folder list, or the note stack of the
        folder that was entered.
    -->
    <!--
        Slice 1.3: the root is the drawer's unmoving surface; WorkspaceContent,
        inside it, is what moves when the drawer is shown or hidden. The window
        never moves, so the content slides and fades inside the docked
        rectangle over the sidebar colour, never over nothing.
    -->
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource SurfaceSidebarBrush}">

        <!--
            Ctrl+W hides the workspace from any surface (parity A10, G7). On
            the root, so it works wherever focus sits.
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnDismissAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid x:Name="WorkspaceContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The workspace header, shared by every surface. Settings (Slice 1)
                opens the settings surface, as Ctrl+, and the tray's Settings… do.
                Pin (parity A9) keeps the workspace open while another application
                has the keyboard. A toggle reachable by Tab, with no global chord:
                G6, the global pin shortcut, is unbound by default. Session-only.
            -->
            <Grid
                x:Name="WorkspaceHeader"
                Grid.Row="0"
                Background="{ThemeResource SurfaceSidebarBrush}"
                Padding="{StaticResource PanePadding}">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceXS}">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings (Ctrl+,)"
                        AutomationProperties.Name="Settings"
                        AutomationProperties.AcceleratorKey="Control+Comma">
                        <FontIcon Glyph="&#xE713;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <ToggleButton
                        x:Name="PinToggle"
                        Style="{StaticResource HeaderToggleButtonStyle}"
                        Checked="OnPinToggled"
                        Unchecked="OnPinToggled"
                        ToolTipService.ToolTip="Keep Noto open"
                        AutomationProperties.Name="Keep Noto open">
                        <FontIcon Glyph="&#xE718;" FontSize="{StaticResource IconSize}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid x:Name="PaneRoot"
                  Grid.Row="1"
                  KeyDown="OnPaneRootKeyDown"
                  Background="{ThemeResource SurfaceSidebarBrush}"
                  Padding="{StaticResource PanePadding}"
                  RowSpacing="{StaticResource SpaceS}">

                <!--
                    Ctrl+N creates a folder (parity C2). Scoped to this pane, not
                    registered globally: the global activation surface is a separate
                    M2 concern and principle 7 wants each one independently
                    disableable.
                -->
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateAccelerator" />

                </Grid.KeyboardAccelerators>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Create: the input and its affordance share one row. -->
                <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="FolderNameInput"
                        Grid.Column="0"
                        Style="{StaticResource FolderNameInputStyle}"
                        PlaceholderText="New folder name"
                        KeyDown="OnCreateInputKeyDown"
                        AutomationProperties.Name="New folder name" />

                    <Button
                        x:Name="CreateButton"
                        Grid.Column="1"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        Content="Create"
                        Click="OnCreateFolderClick"
                        AutomationProperties.Name="Create folder" />
                </Grid>

                <!--
                    Guidance and notices are SEPARATE lines, stacked.

                    They answer different questions and can both be true at once: with
                    no folders and a failed create, the user needs to know that the
                    list is empty AND that the attempt failed. One shared line made the
                    notice destroy the empty-state context.
                -->
                <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                    <TextBlock
                        x:Name="GuidanceText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed" />

                    <!--
                        No AutomationProperties.Name: a static name on a TextBlock
                        REPLACES its text for assistive technology, so a screen reader
                        would announce "Folder pane notice" and never the actual error.
                        The text is the name. LiveSetting announces it when it appears,
                        which is the whole point of a validation message.
                    -->
                    <TextBlock
                        x:Name="NoticeText"
                        Style="{StaticResource FolderPaneNoticeStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Assertive" />

                    <!--
                        Recovery from Error. Only visible in Error, because there is
                        nothing to retry otherwise — and without it the pane is a dead
                        end: Error disables the list, the input and Create, so the
                        query can never be reattempted.
                    -->
                    <Button
                        x:Name="RetryButton"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="Retry"
                        Visibility="Collapsed"
                        Click="OnRetryClick"
                        AutomationProperties.Name="Retry loading folders" />

                </StackPanel>

                <!--
                    The inline rename editor (parity C13). One editor reused for
                    whichever row is being renamed rather than an editable template on
                    every row: a TextBox per row would be created for every folder in
                    the list and only one can ever be active.
                -->
                <TextBox
                    x:Name="RenameEditor"
                    Grid.Row="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource FolderNameInputStyle}"
                    Visibility="Collapsed"
                    KeyDown="OnRenameEditorKeyDown"
                    LostFocus="OnRenameEditorLostFocus"
                    Canvas.ZIndex="1"
                    AutomationProperties.Name="Rename folder" />

                <ListView
                    x:Name="FolderList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind Folders}"
                    ItemContainerStyle="{StaticResource FolderRowStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnFolderSelectionChanged"
                    KeyDown="OnFolderListKeyDown"
                    Tapped="OnFolderListTapped"
                    DoubleTapped="OnFolderListDoubleTapped"
                    PreviewKeyDown="OnFolderListPreviewKeyDown"
                    ContextRequested="OnFolderListContextRequested"
                    AutomationProperties.Name="Folders">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderListItem">
                            <!--
                                Pinned folders sort to the top (O2). The marker makes
                                that grouping visible; without it the order looks
                                arbitrary to the user.
                            -->
                            <Grid ColumnSpacing="{StaticResource SpaceXS}"
                                  AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--
                                    A text glyph rather than an emoji: a colour emoji
                                    renders from the font's own palette, so it ignores
                                    the theme and stays the same pink in high contrast,
                                    where the user's chosen colours must win.
                                -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="●"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind PinnedMarkerVisibility}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--
                The note stack (ADR-016): the second of two surfaces. Entering a folder swaps it in and Back or Escape
                swaps the folder list back (C1, C5). Its notes are cards, each edited in place; exactly one card at a
                time holds the editor and its bar, so a realised card that is not being edited is only its read view.
            -->
            <Grid x:Name="NoteRoot"
                  Grid.Row="1"
                  KeyDown="OnNoteRootKeyDown"
                  Background="{ThemeResource SurfaceSidebarBrush}"
                  Padding="{StaticResource PanePadding}"
                  RowSpacing="{StaticResource SpaceS}"
                  Visibility="Collapsed">

                <!--
                    Ctrl+N creates a note at the configured placement and edits it (B1, B5), from anywhere in the
                    stack, the editor included. On the surface's root, not the list: an empty folder has no card to
                    take focus (#69).
                -->
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateNoteAccelerator" />
                </Grid.KeyboardAccelerators>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Back is the pointer route out; Escape is the keyboard's (C5). -->
                <Button
                    x:Name="BackButton"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnBackClick"
                    AutomationProperties.Name="Back to folders" />

                <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                    <TextBlock
                        x:Name="NoteGuidanceText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed" />

                    <!--
                        No AutomationProperties.Name: a static name on a TextBlock REPLACES its text for assistive
                        technology, so a screen reader would announce the label and never the message.
                    -->
                    <TextBlock
                        x:Name="NoteNoticeText"
                        Style="{StaticResource FolderPaneNoticeStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Assertive" />

                    <Button
                        x:Name="NoteRetryButton"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="Retry"
                        Visibility="Collapsed"
                        Click="OnNoteRetryClick"
                        AutomationProperties.Name="Retry loading notes" />

                </StackPanel>

                <!--
                    The stack. A ListView (ADR-016 §4): virtualisation, single selection, keyboard movement, list
                    semantics and, later, reorder come from the framework. Selection is the focused or editing card.
                -->
                <ListView
                    x:Name="NoteList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind Notes}"
                    ItemContainerStyle="{StaticResource NoteRowStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnNoteSelectionChanged"
                    PreviewKeyDown="OnNoteListPreviewKeyDown"
                    Tapped="OnNoteListTapped"
                    ContextRequested="OnNoteListContextRequested"
                    AutomationProperties.Name="Notes">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NoteCard">
                            <Grid ColumnSpacing="{StaticResource SpaceXS}"
                                  RowSpacing="{StaticResource SpaceXS}"
                                  AutomationProperties.Name="{x:Bind DisplayTitle, Mode=OneWay}"
                                  AutomationProperties.HelpText="{x:Bind HelpText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- The read view: the whole note, or its title when folded. -->
                                <TextBlock
                                    x:Name="CardReadView"
                                    x:Load="{x:Bind IsReading, Mode=OneWay}"
                                    Grid.Column="0"
                                    Text="{x:Bind ReadText, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <!-- The editor, only on the card being edited. -->
                                <local:NoteEditorHost
                                    x:Name="CardEditor"
                                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                    Grid.Column="0"
                                    Loaded="OnEditorHostLoaded"
                                    Unloaded="OnEditorHostUnloaded" />

                                <!--
                                    A text glyph rather than an emoji: a colour emoji keeps its own palette, so it
                                    would ignore high contrast, where the user's colours must win.
                                -->
                                <TextBlock
                                    Grid.Column="1"
                                    Text="●"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind PinnedMarkerVisibility}"
                                    AutomationProperties.AccessibilityView="Raw" />

                                <!-- The card's bar (B17), on the card being edited. Phase B adds pin, fold and move. -->
                                <StackPanel
                                    x:Name="CardBar"
                                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SpaceXS}">
                                    <Button
                                        Style="{StaticResource HeaderButtonStyle}"
                                        Click="OnDeleteCardClick"
                                        ToolTipService.ToolTip="Move to the Recycle Bin (Ctrl+Alt+Backspace)"
                                        AutomationProperties.Name="Move to the Recycle Bin"
                                        AutomationProperties.AcceleratorKey="Control+Alt+Back">
                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconSize}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The list's bar (B18, C19): how many notes, and a new one. -->
                <Grid Grid.Row="3" ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="NoteCountText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource FolderPaneGuidanceStyle}" />

                    <Button
                        x:Name="NewNoteButton"
                        Grid.Column="1"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="OnNewNoteClick"
                        ToolTipService.ToolTip="New note (Ctrl+N)"
                        AutomationProperties.Name="New note"
                        AutomationProperties.AcceleratorKey="Control+N">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSize}" />
                    </Button>
                </Grid>
            </Grid>

            <!--
                Settings (Slice 1), the third surface, is not declared here: it is
                created in code each time it is opened, beside these surfaces, and
                removed when it is left (MainWindow.OpenSettings, CloseSettings).
                Deferred loading (x:Load) is not usable in a Window: measured, the
                framework never realises a static x:Load element under a Window,
                and the compiler's bound form calls a FindName a Window lacks.
            -->
        </Grid>
    </Grid>

</Window>
