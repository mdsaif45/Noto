<Window
    x:Class="Noto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto"
    Title="Noto">

    <!--
        M2-1 — the Folder Pane. The first production surface, and the first to
        consume the design system (ADR-011): every colour, spacing, radius and
        type value below comes from a semantic token, and there is no literal
        visual value in this file.

        Still NOT the workspace: no docking (#16), no global hotkey, no note
        list and no editor. Entering a folder is parity C4 and deliberately
        unimplemented, which is why Enter is left unbound on a row.
    -->

    <!--
        The workspace host. Exactly one surface is visible at a time
        (replacing navigation, C1): the folder list, or the notes of the
        folder that was entered.
    -->
    <Grid x:Name="WorkspaceRoot">
        <Grid x:Name="PaneRoot"
              Background="{ThemeResource SurfaceSidebarBrush}"
              Padding="{StaticResource PanePadding}"
              RowSpacing="{StaticResource SpaceS}">

            <!--
                Ctrl+N creates a folder (parity C2). Scoped to this pane, not
                registered globally: the global activation surface is a separate
                M2 concern and principle 7 wants each one independently
                disableable.
            -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateAccelerator" />

            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Create: the input and its affordance share one row. -->
            <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="FolderNameInput"
                    Grid.Column="0"
                    Style="{StaticResource FolderNameInputStyle}"
                    PlaceholderText="New folder name"
                    KeyDown="OnCreateInputKeyDown"
                    AutomationProperties.Name="New folder name" />

                <Button
                    x:Name="CreateButton"
                    Grid.Column="1"
                    Style="{StaticResource FolderPaneButtonStyle}"
                    Content="Create"
                    Click="OnCreateFolderClick"
                    AutomationProperties.Name="Create folder" />
            </Grid>

            <!--
                Guidance and notices are SEPARATE lines, stacked.

                They answer different questions and can both be true at once: with
                no folders and a failed create, the user needs to know that the
                list is empty AND that the attempt failed. One shared line made the
                notice destroy the empty-state context.
            -->
            <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                <TextBlock
                    x:Name="GuidanceText"
                    Style="{StaticResource FolderPaneGuidanceStyle}"
                    Visibility="Collapsed" />

                <!--
                    No AutomationProperties.Name: a static name on a TextBlock
                    REPLACES its text for assistive technology, so a screen reader
                    would announce "Folder pane notice" and never the actual error.
                    The text is the name. LiveSetting announces it when it appears,
                    which is the whole point of a validation message.
                -->
                <TextBlock
                    x:Name="NoticeText"
                    Style="{StaticResource FolderPaneNoticeStyle}"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Assertive" />

                <!--
                    Recovery from Error. Only visible in Error, because there is
                    nothing to retry otherwise — and without it the pane is a dead
                    end: Error disables the list, the input and Create, so the
                    query can never be reattempted.
                -->
                <Button
                    x:Name="RetryButton"
                    Style="{StaticResource FolderPaneButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="Retry"
                    Visibility="Collapsed"
                    Click="OnRetryClick"
                    AutomationProperties.Name="Retry loading folders" />

            </StackPanel>

            <!--
                The inline rename editor (parity C13). One editor reused for
                whichever row is being renamed rather than an editable template on
                every row: a TextBox per row would be created for every folder in
                the list and only one can ever be active.
            -->
            <TextBox
                x:Name="RenameEditor"
                Grid.Row="2"
                VerticalAlignment="Top"
                Style="{StaticResource FolderNameInputStyle}"
                Visibility="Collapsed"
                KeyDown="OnRenameEditorKeyDown"
                LostFocus="OnRenameEditorLostFocus"
                Canvas.ZIndex="1"
                AutomationProperties.Name="Rename folder" />

            <ListView
                x:Name="FolderList"
                Grid.Row="2"
                ItemsSource="{x:Bind Folders}"
                ItemContainerStyle="{StaticResource FolderRowStyle}"
                SelectionMode="Single"
                SelectionChanged="OnFolderSelectionChanged"
                KeyDown="OnFolderListKeyDown"
                DoubleTapped="OnFolderListDoubleTapped"
                PreviewKeyDown="OnFolderListPreviewKeyDown"
                AutomationProperties.Name="Folders">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderListItem">
                        <!--
                            Pinned folders sort to the top (O2). The marker makes
                            that grouping visible; without it the order looks
                            arbitrary to the user.
                        -->
                        <Grid ColumnSpacing="{StaticResource SpaceXS}"
                              AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                A text glyph rather than an emoji: a colour emoji
                                renders from the font's own palette, so it ignores
                                the theme and stays the same pink in high contrast,
                                where the user's chosen colours must win.
                            -->
                            <TextBlock
                                Grid.Column="0"
                                Text="●"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="{StaticResource FontSizeCaption}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind PinnedMarkerVisibility}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--
            The note surface. Replacing navigation (C1): exactly one of the two
            surfaces is visible, so entering a folder swaps this in and Esc swaps
            it back. Not a split view — the folder list is the top-level view and
            C5/A12 both describe returning TO it, which only means something if it
            was replaced.
        -->
        <Grid x:Name="NoteRoot"
              KeyDown="OnNoteRootKeyDown"
              Background="{ThemeResource SurfaceSidebarBrush}"
              Padding="{StaticResource PanePadding}"
              RowSpacing="{StaticResource SpaceS}"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Back is the pointer route out. Esc is the keyboard route, but a
                surface reachable only by a key the user has to guess is not
                reachable; C5 documents a back control for the same reason.
            -->
            <Button
                x:Name="BackButton"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Style="{StaticResource FolderPaneButtonStyle}"
                Click="OnBackClick"
                AutomationProperties.Name="Back to folders" />

            <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                <TextBlock
                    x:Name="NoteGuidanceText"
                    Style="{StaticResource FolderPaneGuidanceStyle}"
                    Visibility="Collapsed" />

                <!--
                    No AutomationProperties.Name: a static name on a TextBlock
                    REPLACES its text for assistive technology, so a screen reader
                    would announce the label and never the actual message.
                -->
                <TextBlock
                    x:Name="NoteNoticeText"
                    Style="{StaticResource FolderPaneNoticeStyle}"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Assertive" />

                <Button
                    x:Name="NoteRetryButton"
                    Style="{StaticResource FolderPaneButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="Retry"
                    Visibility="Collapsed"
                    Click="OnNoteRetryClick"
                    AutomationProperties.Name="Retry loading notes" />

            </StackPanel>

            <ListView
                x:Name="NoteList"
                Grid.Row="2"
                ItemsSource="{x:Bind Notes}"
                ItemContainerStyle="{StaticResource NoteRowStyle}"
                SelectionMode="Single"
                SelectionChanged="OnNoteSelectionChanged"
                KeyDown="OnNoteListKeyDown"
                DoubleTapped="OnNoteListDoubleTapped"
                AutomationProperties.Name="Notes">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NoteListItem">
                        <Grid ColumnSpacing="{StaticResource SpaceXS}"
                              AutomationProperties.Name="{x:Bind DisplayTitle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="●"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="{StaticResource FontSizeCaption}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind PinnedMarkerVisibility}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind DisplayTitle}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--
            The note editor. The third surface in the same replacing-navigation
            model: entering a note swaps this in, Esc or Back swaps it back.

            Plain source. ADR-004 stores markdown and #14 scopes M2 to editing
            it raw — the invisible-markdown editor is M3 and rebuilding this
            surface for it is expected, so nothing here anticipates it.
        -->
        <Grid x:Name="EditorRoot"
              KeyDown="OnEditorRootKeyDown"
              Background="{ThemeResource SurfaceSidebarBrush}"
              Padding="{StaticResource PanePadding}"
              RowSpacing="{StaticResource SpaceS}"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="EditorBackButton"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Style="{StaticResource FolderPaneButtonStyle}"
                Click="OnEditorBackClick"
                AutomationProperties.Name="Back to notes" />

            <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                <TextBlock
                    x:Name="EditorGuidanceText"
                    Style="{StaticResource FolderPaneGuidanceStyle}"
                    Visibility="Collapsed" />

                <!--
                    No AutomationProperties.Name: a static name on a TextBlock
                    REPLACES its text for assistive technology.
                -->
                <TextBlock
                    x:Name="EditorNoticeText"
                    Style="{StaticResource FolderPaneNoticeStyle}"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Assertive" />

                <Button
                    x:Name="EditorRetryButton"
                    Style="{StaticResource FolderPaneButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="Retry"
                    Visibility="Collapsed"
                    Click="OnEditorRetryClick"
                    AutomationProperties.Name="Retry loading the note" />

            </StackPanel>

            <!--
                AcceptsReturn and no AcceptsTab: Enter inserts a newline, which
                a markdown note needs, while Tab stays a focus move so the
                surface remains keyboard-escapable.
            -->
            <TextBox
                x:Name="NoteEditor"
                Grid.Row="2"
                Style="{StaticResource NoteEditorStyle}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="OnNoteEditorTextChanged"
                AutomationProperties.Name="Note content" />
        </Grid>
    </Grid>

</Window>
