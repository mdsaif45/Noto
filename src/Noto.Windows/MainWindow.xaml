<Window
    x:Class="Noto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto"
    Title="Noto">

    <!--
        The workspace: the folder pane (M2-1) and the note stack (ADR-016),
        under one header. Every colour, spacing, radius and
        type value below comes from a semantic token of the design system
        (ADR-011); there is no literal visual value in this file.

        The window around it is the #16 drawer, owned by App.xaml.cs and
        WindowCoordinator: docked to an edge, topmost while shown, toggled by
        the global hotkey, put away by Ctrl+W, Escape or losing activation.
    -->

    <!--
        The workspace host. Exactly one surface is visible at a time
        (replacing navigation, C1): the folder list, or the note stack of the
        folder that was entered.
    -->
    <!--
        Slice 1.3: the root is the drawer's unmoving surface; WorkspaceContent,
        inside it, is what moves when the drawer is shown or hidden. The window
        never moves, so the content slides and fades inside the docked
        rectangle over the sidebar colour, never over nothing.
    -->
    <!--
        KeyboardAcceleratorPlacementMode="Hidden" on every element that hosts accelerators (B6, F1): WinUI would
        otherwise pop an automatic key-tip tooltip ("Ctrl+N") when a modifier is held. Each button's own tooltip
        already names its key.
    -->
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource SurfaceSidebarBrush}" KeyboardAcceleratorPlacementMode="Hidden">

        <!--
            Ctrl+W hides the workspace from any surface (parity A10, G7). On
            the root, so it works wherever focus sits.
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnDismissAccelerator" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnKeepOpenAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid x:Name="WorkspaceContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The workspace header, shared by every surface. Settings (Slice 1)
                opens the settings surface, as Ctrl+, and the tray's Settings… do.
                Pin (parity A9) keeps the workspace open while another application
                has the keyboard. A toggle reachable by Tab, with no global chord:
                G6, the global pin shortcut, is unbound by default. Session-only.
            -->
            <Grid
                x:Name="WorkspaceHeader"
                Grid.Row="0"
                Background="{ThemeResource SurfaceSidebarBrush}"
                Padding="{StaticResource PanePadding}">
                <TextBlock
                    Text="Noto"
                    Style="{StaticResource AppTitleStyle}"
                    AutomationProperties.AccessibilityView="Raw" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceXS}">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings (Ctrl+,)"
                        AutomationProperties.Name="Settings"
                        AutomationProperties.AcceleratorKey="Control+Comma">
                        <FontIcon Glyph="&#xE713;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <ToggleButton
                        x:Name="PinToggle"
                        Style="{StaticResource HeaderToggleButtonStyle}"
                        Checked="OnPinToggled"
                        Unchecked="OnPinToggled"
                        ToolTipService.ToolTip="Keep Noto open (Ctrl+D)"
                        AutomationProperties.Name="Keep Noto open"
                        AutomationProperties.AcceleratorKey="Control+D">
                        <FontIcon Glyph="&#xE718;" FontSize="{StaticResource IconSize}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid x:Name="PaneRoot"
                  Grid.Row="1"
                  KeyboardAcceleratorPlacementMode="Hidden"
                  KeyDown="OnPaneRootKeyDown"
                  Background="{ThemeResource SurfaceSidebarBrush}"
                  Padding="{StaticResource PanePadding}"
                  RowSpacing="{StaticResource SpaceS}">

                <!--
                    Ctrl+N creates a folder (parity C2). Scoped to this pane, not
                    registered globally: the global activation surface is a separate
                    M2 concern and principle 7 wants each one independently
                    disableable.
                -->
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateAccelerator" />

                </Grid.KeyboardAccelerators>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Create: the input and its affordance share one row. -->
                <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="FolderNameInput"
                        Grid.Column="0"
                        Style="{StaticResource FolderNameInputStyle}"
                        PlaceholderText="New folder name"
                        KeyDown="OnCreateInputKeyDown"
                        AutomationProperties.Name="New folder name" />

                    <Button
                        x:Name="CreateButton"
                        Grid.Column="1"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        Content="Create"
                        Click="OnCreateFolderClick"
                        AutomationProperties.Name="Create folder" />
                </Grid>

                <!--
                    Guidance and notices are SEPARATE lines, stacked.

                    They answer different questions and can both be true at once: with
                    no folders and a failed create, the user needs to know that the
                    list is empty AND that the attempt failed. One shared line made the
                    notice destroy the empty-state context.
                -->
                <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                    <TextBlock
                        x:Name="GuidanceText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed" />

                    <!--
                        No AutomationProperties.Name: a static name on a TextBlock
                        REPLACES its text for assistive technology, so a screen reader
                        would announce "Folder pane notice" and never the actual error.
                        The text is the name. LiveSetting announces it when it appears,
                        which is the whole point of a validation message.
                    -->
                    <TextBlock
                        x:Name="NoticeText"
                        Style="{StaticResource FolderPaneNoticeStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Assertive" />

                    <!--
                        A result, said quietly: a restore that finished, an export that was written. The secondary
                        colour, announced politely; a failure is the notice above.
                    -->
                    <TextBlock
                        x:Name="StatusText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite" />

                    <!--
                        Recovery from Error. Only visible in Error, because there is
                        nothing to retry otherwise — and without it the pane is a dead
                        end: Error disables the list, the input and Create, so the
                        query can never be reattempted.
                    -->
                    <Button
                        x:Name="RetryButton"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="Retry"
                        Visibility="Collapsed"
                        Click="OnRetryClick"
                        AutomationProperties.Name="Retry loading folders" />

                </StackPanel>

                <!--
                    The inline rename editor (parity C13). One editor reused for
                    whichever row is being renamed rather than an editable template on
                    every row: a TextBox per row would be created for every folder in
                    the list and only one can ever be active.
                -->
                <TextBox
                    x:Name="RenameEditor"
                    Grid.Row="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource FolderNameInputStyle}"
                    Visibility="Collapsed"
                    KeyDown="OnRenameEditorKeyDown"
                    LostFocus="OnRenameEditorLostFocus"
                    Canvas.ZIndex="1"
                    AutomationProperties.Name="Rename folder" />

                <ListView
                    x:Name="FolderList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind Folders}"
                    ItemContainerStyle="{StaticResource FolderRowStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnFolderSelectionChanged"
                    KeyDown="OnFolderListKeyDown"
                    Tapped="OnFolderListTapped"
                    DoubleTapped="OnFolderListDoubleTapped"
                    PreviewKeyDown="OnFolderListPreviewKeyDown"
                    ContextRequested="OnFolderListContextRequested"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="OnFolderDragStarting"
                    DragItemsCompleted="OnFolderDragCompleted"
                    AutomationProperties.Name="Folders">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderListItem">
                            <!--
                                Pinned folders sort to the top (O2). The marker makes
                                that grouping visible; without it the order looks
                                arbitrary to the user.
                            -->
                            <Grid ColumnSpacing="{StaticResource IconLabelSpacing}"
                                  AutomationProperties.Name="{x:Bind Name}"
                                  AutomationProperties.HelpText="{x:Bind HelpText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--
                                    Glyphs from the system's icon font, in the row's own colour: a colour emoji keeps its
                                    own palette, so it would ignore the theme and high contrast, where the user's colours
                                    must win. The pin marker is after the name, as the stack's cards place theirs.
                                -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B7;"
                                    FontSize="{StaticResource IconSize}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    Grid.Column="2"
                                    Glyph="&#xE718;"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Visibility="{x:Bind PinnedMarkerVisibility}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <!-- The note count (#147): read by screen readers in the row's help text, not twice. -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind CountText}"
                                    Style="{StaticResource FolderRowCountStyle}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The Recycle Bin (Phase B5): a surface of its own, opened from here. -->
                <Button
                    x:Name="RecycleBinButton"
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnRecycleBinClick"
                    ToolTipService.ToolTip="Deleted notes and folders"
                    AutomationProperties.Name="Recycle Bin">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource IconLabelSpacing}">
                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconSize}" />
                        <TextBlock Text="Recycle Bin" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--
                The note stack (ADR-016): the second of two surfaces. Entering a folder swaps it in and Back or Escape
                swaps the folder list back (C1, C5). Its notes are cards, each edited in place; exactly one card at a
                time holds the editor and its bar, so a realised card that is not being edited is only its read view.
            -->
            <Grid x:Name="NoteRoot"
                  Grid.Row="1"
                  KeyboardAcceleratorPlacementMode="Hidden"
                  KeyDown="OnNoteRootKeyDown"
                  Background="{ThemeResource SurfaceSidebarBrush}"
                  Padding="{StaticResource PanePadding}"
                  RowSpacing="{StaticResource SpaceS}"
                  Visibility="Collapsed">

                <!--
                    Ctrl+N creates a note at the configured placement and edits it (B1, B5), from anywhere in the
                    stack, the editor included. On the surface's root, not the list: an empty folder has no card to
                    take focus (#69).
                -->
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCreateNoteAccelerator" />
                    <!-- Move the current card to another folder (B11, G16), from a card or its editor. -->
                    <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="OnMoveAccelerator" />
                </Grid.KeyboardAccelerators>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    The stack's heading: Back, then the folder's name, as Settings and the Recycle Bin head theirs. Back is
                    the pointer route out; Escape is the keyboard's (C5).
                -->
                <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpaceXS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="Back to folders (Esc)"
                        AutomationProperties.Name="Back to folders">
                        <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <TextBlock
                        x:Name="NoteFolderTitle"
                        Grid.Column="1"
                        Style="{StaticResource SurfaceTitleStyle}"
                        AutomationProperties.HeadingLevel="Level1" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceXS}">

                    <TextBlock
                        x:Name="NoteGuidanceText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed" />

                    <!--
                        No AutomationProperties.Name: a static name on a TextBlock REPLACES its text for assistive
                        technology, so a screen reader would announce the label and never the message.
                    -->
                    <TextBlock
                        x:Name="NoteNoticeText"
                        Style="{StaticResource FolderPaneNoticeStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock
                        x:Name="NoteStatusText"
                        Style="{StaticResource FolderPaneGuidanceStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite" />

                    <Button
                        x:Name="NoteRetryButton"
                        Style="{StaticResource FolderPaneButtonStyle}"
                        HorizontalAlignment="Left"
                        Content="Retry"
                        Visibility="Collapsed"
                        Click="OnNoteRetryClick"
                        AutomationProperties.Name="Retry loading notes" />

                </StackPanel>

                <!--
                    The stack. A ListView (ADR-016 §4): virtualisation, single selection, keyboard movement, list
                    semantics and, later, reorder come from the framework. Selection is the focused or editing card.
                -->
                <ListView
                    x:Name="NoteList"
                    Grid.Row="2"
                    ItemsSource="{x:Bind Notes}"
                    ItemContainerStyle="{StaticResource NoteCardStyle}"
                    SelectionMode="Single"
                    SelectionChanged="OnNoteSelectionChanged"
                    PreviewKeyDown="OnNoteListPreviewKeyDown"
                    Tapped="OnNoteListTapped"
                    ContextRequested="OnNoteListContextRequested"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="OnNoteDragStarting"
                    DragItemsCompleted="OnNoteDragCompleted"
                    AutomationProperties.Name="Notes">
                    <!--
                        Virtualised, keeping its scroll offset when a card changes size. The default (KeepItemsInView)
                        re-anchors on the items as they change, and a card being edited can be tens of thousands of
                        pixels tall: replacing all of a ~100 KB note's text twice in a folder of 50 cards ended Noto
                        inside WinUI (0xC000027B, measured 2026-11-05; never with this mode, 10 cycles at 100 KB and 6
                        at 150 KB). The caret is still brought into view by the editor.
                    -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NoteCard">
                            <Grid ColumnSpacing="{StaticResource SpaceXS}"
                                  RowSpacing="{StaticResource SpaceXS}"
                                  AutomationProperties.Name="{x:Bind DisplayTitle, Mode=OneWay}"
                                  AutomationProperties.HelpText="{x:Bind HelpText, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    The read view: the whole note rendered from the same parse the editor styles with,
                                    markup left out (ADR-017), or its title when folded. Not selectable: a click edits.
                                -->
                                <local:MarkdownReadView
                                    x:Name="CardReadView"
                                    x:Load="{x:Bind IsReading, Mode=OneWay}"
                                    Grid.Column="0"
                                    MarkupBrush="{ThemeResource TextSecondaryBrush}"
                                    LinkBrush="{ThemeResource TextLinkBrush}"
                                    Source="{x:Bind ReadText, Mode=OneWay}" />

                                <!-- The editor, only on the card being edited. -->
                                <local:NoteEditorHost
                                    x:Name="CardEditor"
                                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                    Grid.Column="0"
                                    Loaded="OnEditorHostLoaded"
                                    DataContextChanged="OnEditorHostDataContextChanged"
                                    Unloaded="OnEditorHostUnloaded" />

                                <!--
                                    Glyphs from the system's icon font, in the card's own colour: a colour emoji keeps its
                                    own palette, so it would ignore high contrast, where the user's colours must win.
                                -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Spacing="{StaticResource SpaceXS}">
                                    <FontIcon
                                        Glyph="&#xE718;"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Visibility="{x:Bind PinnedMarkerVisibility}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <!-- Folded (B12): a chevron in the row's own colour, so high contrast keeps it. -->
                                    <FontIcon
                                        Glyph="&#xE76C;"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Visibility="{x:Bind FoldedMarkerVisibility, Mode=OneWay}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>

                                <!-- The card's bar (B17), on the card being edited. Phase B adds pin, fold and move. -->
                                <StackPanel
                                    x:Name="CardBar"
                                    x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SpaceXS}">
                                    <!--
                                        Formatting (ADR-017): one quiet button, every command with its key, so the menu
                                        teaches the keys. Keyboard formatting never needs it.
                                    -->
                                    <Button
                                        x:Name="CardFormatButton"
                                        Style="{StaticResource HeaderButtonStyle}"
                                        ToolTipService.ToolTip="Format"
                                        AutomationProperties.Name="Format">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="{StaticResource IconSize}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Bold" Tag="Bold" KeyboardAcceleratorTextOverride="Ctrl+B" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Italic" Tag="Italic" KeyboardAcceleratorTextOverride="Ctrl+I" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Underline" Tag="Underline" KeyboardAcceleratorTextOverride="Ctrl+U" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Strikethrough" Tag="Strikethrough" KeyboardAcceleratorTextOverride="Ctrl+Shift+E" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Code" Tag="Code" KeyboardAcceleratorTextOverride="Ctrl+E" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Link" Tag="Link" KeyboardAcceleratorTextOverride="Ctrl+K" Click="OnFormatClick" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Heading" Tag="Heading" KeyboardAcceleratorTextOverride="Ctrl+Shift+H" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Bulleted list" Tag="Bullets" KeyboardAcceleratorTextOverride="Ctrl+L" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Numbered list" Tag="Numbers" KeyboardAcceleratorTextOverride="Ctrl+Shift+L" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Checklist" Tag="Tasks" KeyboardAcceleratorTextOverride="Ctrl+T" Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Check or uncheck" Tag="TaskDone" KeyboardAcceleratorTextOverride="Ctrl+." Click="OnFormatClick" />
                                                <MenuFlyoutItem Text="Code block" Tag="CodeBlock" Click="OnFormatClick" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Show or hide markup" Tag="ShowMarkup" KeyboardAcceleratorTextOverride="Ctrl+Shift+R" Click="OnFormatClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button
                                        Style="{StaticResource HeaderButtonStyle}"
                                        Click="OnDeleteCardClick"
                                        ToolTipService.ToolTip="Move to the Recycle Bin (Ctrl+Alt+Backspace)"
                                        AutomationProperties.Name="Move to the Recycle Bin"
                                        AutomationProperties.AcceleratorKey="Control+Alt+Back">
                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource IconSize}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The list's bar (B18, C19): how many notes, and a new one. -->
                <Grid Grid.Row="3" ColumnSpacing="{StaticResource SpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="NoteCountText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource FolderPaneGuidanceStyle}" />

                    <Button
                        x:Name="NewNoteButton"
                        Grid.Column="1"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="OnNewNoteClick"
                        ToolTipService.ToolTip="New note (Ctrl+N)"
                        AutomationProperties.Name="New note"
                        AutomationProperties.AcceleratorKey="Control+N">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSize}" />
                    </Button>
                </Grid>
            </Grid>

            <!--
                Settings (Slice 1), the third surface, is not declared here: it is
                created in code each time it is opened, beside these surfaces, and
                removed when it is left (MainWindow.OpenSettings, CloseSettings).
                Deferred loading (x:Load) is not usable in a Window: measured, the
                framework never realises a static x:Load element under a Window,
                and the compiler's bound form calls a FindName a Window lacks.
            -->
        </Grid>
    </Grid>

</Window>
