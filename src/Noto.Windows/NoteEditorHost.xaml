<UserControl
    x:Class="Noto.NoteEditorHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Noto">

    <!--
        The editor host (ADR-016 §3): the only thing that edits a note's text, and the P2 boundary. Callers see Load,
        Markdown, ContentChanged, LeaveRequested, PlaceCaret and the formatting commands; nothing else.

        P2 (ADR-017): a RichEditBox whose text is the markdown source, its markup hidden by format and styled from
        Core's parse. RichEdit's own undo and formatting chords are off: Noto owns both. It grows with its text inside
        the card up to the stack's own height (MaxHeight, set by the stack), and a longer note scrolls inside its card
        while it is edited (ADR-017, amended by the performance and stability slice: grown without a limit, every
        keystroke laid out the whole note, 259 ms a key at 100 KB). The brushes are theme resources, so a theme switch
        restyles the note.

        TaskMarks draws a checkbox over each task's marker and box, which the editor keeps in the text (the source)
        but draws invisibly; ImageMarks draws the pictures. Neither takes input: a click reaches the editor, which
        toggles the task it hit. Both follow the editor's own scroll (their shifts) and are clipped to it (EditorRoot).
    -->
    <Grid x:Name="EditorRoot">
        <local:EditorBox
            x:Name="NoteEditor"
            Style="{StaticResource NoteEditorStyle}"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            IsSpellCheckEnabled="True"
            DisabledFormattingAccelerators="All"
            ClipboardCopyFormat="PlainText"
            MarkupBrush="{ThemeResource TextSecondaryBrush}"
            LinkBrush="{ThemeResource TextLinkBrush}"
            CodeSurfaceBrush="{ThemeResource SurfaceCodeBrush}"
            MarkBrush="{ThemeResource MarkBrush}"
            MarkTextBrush="{ThemeResource MarkTextBrush}"
            AllowDrop="True"
            AutomationProperties.Name="Note content" />
        <Canvas
            x:Name="ImageMarks"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="ImageMarksShift" />
            </Canvas.RenderTransform>
        </Canvas>
        <!--
            F8 (#151): the quick-formatting toolbar, above a selection. Its buttons never take focus from the text (not
            tab stops, no focus on a click) and run the same commands as the keys and the Format menu. Off in Settings.
        -->
        <Popup x:Name="FormatBar" IsLightDismissEnabled="False">
            <Border
                x:Name="FormatToolbar"
                Style="{StaticResource FormatToolbarStyle}"
                AutomationProperties.Name="Formatting">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="ToolbarBold"
                        Tag="Bold"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Bold (Ctrl+B)"
                        AutomationProperties.Name="Bold">
                        <FontIcon Glyph="&#xE8DD;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarItalic"
                        Tag="Italic"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Italic (Ctrl+I)"
                        AutomationProperties.Name="Italic">
                        <FontIcon Glyph="&#xE8DB;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarHighlight"
                        Tag="Highlight"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Highlight"
                        AutomationProperties.Name="Highlight">
                        <FontIcon Glyph="&#xE7E6;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarStrikethrough"
                        Tag="Strikethrough"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Strikethrough (Ctrl+Shift+E)"
                        AutomationProperties.Name="Strikethrough">
                        <FontIcon Glyph="&#xEDE0;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarUnderline"
                        Tag="Underline"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Underline (Ctrl+U)"
                        AutomationProperties.Name="Underline">
                        <FontIcon Glyph="&#xE8DC;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarLink"
                        Tag="Link"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Link (Ctrl+K)"
                        AutomationProperties.Name="Link">
                        <FontIcon Glyph="&#xE71B;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarCode"
                        Tag="Code"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Code (Ctrl+E)"
                        AutomationProperties.Name="Code">
                        <FontIcon Glyph="&#xE943;" FontSize="{StaticResource IconSize}" />
                    </Button>
                    <Button
                        x:Name="ToolbarBullets"
                        Tag="Bullets"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False"
                        Click="OnToolbarClick"
                        ToolTipService.ToolTip="Bulleted list (Ctrl+L)"
                        AutomationProperties.Name="Bulleted list">
                        <FontIcon Glyph="&#xE8FD;" FontSize="{StaticResource IconSize}" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
        <Canvas
            x:Name="TaskMarks"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="TaskMarksShift" />
            </Canvas.RenderTransform>
        </Canvas>
    </Grid>

</UserControl>
