<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The workspace's text surfaces: the name input, the note editor, and the
        guidance and notice lines. Their hover, focus and disabled colours come
        from WinUI's TextControl* keys, mapped to Noto's roles in Colors.xaml.
        The buttons are in Buttons.xaml.

        Every visual value is a semantic token; there is no literal colour,
        size, spacing or radius in this file (ADR-011 rule 1). The dictionaries
        these styles consume are merged here rather than assumed present in the
        consumer, per rule 6.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Noto.UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The name input, used both for creating a folder and for renaming one
        in place. SurfaceInputBrush is the first consumer of ADR-011's
        already-declared Input surface role: the field reads as inset because
        it contrasts with the sidebar, not because it carries a shadow.
    -->
    <Style x:Key="FolderNameInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!--
        The note editor's text surface: the card itself (the visual refresh). The note is edited where it is read, on
        the card's own fill, with no box of its own and no padding of its own: the card's padding is the editor's, so the
        text does not move when editing starts. The card's accent edge says which note is being edited.
    -->
    <Style x:Key="NoteEditorStyle" TargetType="RichEditBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!--
        The notice line. TextDangerBrush is the first consumer of the declared
        Danger semantic role, and the reason a validation message cannot reuse
        TextSecondaryBrush: secondary is a de-emphasis role, and an error that
        is de-emphasised is the one message the user most needs to notice.

        Caption size because the notice sits under the input as a subordinate
        explanation rather than as a heading for it.
    -->
    <Style x:Key="FolderPaneNoticeStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextDangerBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Guidance shown in the empty state and while loading. Secondary rather
        than danger: an empty folder list is an ordinary state, not a fault.
    -->
    <!--
        A surface's title, beside its Back button: the folder in the stack, Settings, the Recycle Bin. One style, so every
        surface's heading has the same size, weight and line, and a long folder name ends in an ellipsis.
    -->
    <Style x:Key="SurfaceTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHeading}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        The application's name at the head of the window, where Windows puts a title: quiet chrome, caption size and
        the secondary colour, so the surface title below it is the first thing read.
    -->
    <Style x:Key="AppTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FolderPaneGuidanceStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A folder row's note count (#147): at the row's right edge, as SideNotes shows it, quiet by its caption size.
        No colour of its own: everything in a row takes the row's text colour, so it holds on the selected fill in
        every theme (a secondary colour measured 1.37:1 on Highlight in high contrast, DesignSystemGuardTests). Tabular
        figures, so counts in a column line up whatever their digits.
    -->
    <Style x:Key="FolderRowCountStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

</ResourceDictionary>
