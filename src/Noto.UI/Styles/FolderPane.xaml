<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The folder pane's own surfaces: the pane itself, the name input, and
        the notice line that reports a failed mutation.

        Every visual value is a semantic token; there is no literal colour,
        size, spacing or radius in this file (ADR-011 rule 1). The dictionaries
        these styles consume are merged here rather than assumed present in the
        consumer, per rule 6.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Noto.UI/Themes/Brushes.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The name input, used both for creating a folder and for renaming one
        in place. SurfaceInputBrush is the first consumer of ADR-011's
        already-declared Input surface role: the field reads as inset because
        it contrasts with the sidebar, not because it carries a shadow.
    -->
    <Style x:Key="FolderNameInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource FolderRowPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!--
        The notice line. TextDangerBrush is the first consumer of the declared
        Danger semantic role, and the reason a validation message cannot reuse
        TextSecondaryBrush: secondary is a de-emphasis role, and an error that
        is de-emphasised is the one message the user most needs to notice.

        Caption size because the notice sits under the input as a subordinate
        explanation rather than as a heading for it.
    -->
    <Style x:Key="FolderPaneNoticeStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextDangerBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Guidance shown in the empty state and while loading. Secondary rather
        than danger: an empty folder list is an ordinary state, not a fault.
    -->
    <Style x:Key="FolderPaneGuidanceStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
