<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The settings surface's text and groups (Slice 1). One scrolling page:
        a title, then sections, each a heading over a group of settings.

        The controls inside are WinUI's own ToggleSwitch, ComboBox and Button,
        styled through the lightweight keys in Colors.xaml and Buttons.xaml, so
        every state is Noto's in Light, Dark and High Contrast and the focus
        ring has one source. These styles only lay the page out.

        Every visual value is a semantic token (ADR-011 rule 1), and the
        dictionaries consumed are merged here (rule 6).
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Noto.UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The page title: Heading type. Announced as a level-1 heading by the page. -->
    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHeading}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A section heading: body size at the emphasis weight (BodyStrong). -->
    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
    </Style>

    <!--
        A group of settings: the input surface on the sidebar, a subtle border
        and the Medium radius, so the group reads as one container whose rows
        belong together.
    -->
    <Style x:Key="SettingsGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceInputBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource GroupPadding}" />
    </Style>

    <!-- A setting's name. -->
    <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- What a setting does, under its name: secondary, caption size. -->
    <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
