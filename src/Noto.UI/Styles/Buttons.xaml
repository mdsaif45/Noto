<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The buttons: ADR-011's Button, its subtle variant, and the icon toggle
        in the workspace header.

        A stock WinUI Button inside a tokenised surface carries a foreign visual
        identity, the one thing the design system exists to prevent, so each has
        a template whose every state is a token, in Light, Dark and High
        Contrast:
          Normal            the role's rest fill
          PointerOver       hover fill, InteractionText
          Pressed           pressed fill, InteractionText
          Disabled          disabled text and border
          Checked (toggle)  the selected fill and text, the same "this is on"
                            a selected row shows
          Focused           the two-tone ring, keyboard focus only

        Still ONE button role and no primary/secondary hierarchy: nobody has
        decided one, and no surface needs it yet (ADR-011 rule 4). The subtle
        variant is the same role with no rest fill or border, for navigation
        that should not compete with the content it leads to: the Back buttons.

        Every visual value is a semantic token (ADR-011 rule 1), and the
        dictionaries consumed are merged here (rule 6).
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Noto.UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Tokens/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FolderPaneButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThicknessSubtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource RadiusSmall}">

                        <ContentPresenter x:Name="Content"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <!-- Over the content, so it stays visible on the hover
                             and pressed fills. -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{ThemeResource BorderFocusBrush}"
                                BorderThickness="{StaticResource BorderThicknessFocus}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Opacity="0">
                            <Border BorderBrush="{ThemeResource BorderFocusInnerBrush}"
                                    BorderThickness="{StaticResource BorderThicknessFocusInner}"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                        </Border>

                        <VisualStateManager.VisualStateGroups>

                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionHoverBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionPressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <!--
                                    Disabled dims the text and the border, not
                                    the fill: a greyed-out fill against a
                                    sidebar of similar value reads as "missing"
                                    rather than "unavailable".
                                -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource TextDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />

                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The subtle button: the same template and states, no rest fill and no
        border. Its hover and pressed fills still show, so it is visibly a
        control the moment the pointer reaches it.
    -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource FolderPaneButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
        The header's icon toggle: a 16px glyph in a 32px square, subtle at
        rest, and the selected fill while it is on, so "Keep Noto open" reads
        as on without relying on the glyph. The glyph inherits the state's
        foreground.
    -->
    <Style x:Key="HeaderToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="{StaticResource ControlHeightCompact}" />
        <Setter Property="Height" Value="{StaticResource ControlHeightCompact}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{StaticResource RadiusSmall}">

                        <ContentPresenter x:Name="Content"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <Border x:Name="FocusRing"
                                BorderBrush="{ThemeResource BorderFocusBrush}"
                                BorderThickness="{StaticResource BorderThicknessFocus}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Opacity="0">
                            <Border BorderBrush="{ThemeResource BorderFocusInnerBrush}"
                                    BorderThickness="{StaticResource BorderThicknessFocusInner}"
                                    CornerRadius="{StaticResource RadiusSmall}" />
                        </Border>

                        <VisualStateManager.VisualStateGroups>

                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionHoverBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionPressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionSelectedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionSelectedTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionSelectedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionSelectedTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionPressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InteractionSelectedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />

                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
