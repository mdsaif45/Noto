<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        NoteRow — the note list's row, deliberately the same shape as
        FolderRow.

        A Style over the stock ListViewItem rather than a custom control, for
        the same reasons: WinUI already implements keyboard navigation,
        accessibility peers and virtualisation correctly, and a second control
        would be work spent reaching parity with the framework.

        It is a separate style rather than a reuse of FolderRowStyle because
        the two are different components in ADR-011's library and will diverge
        — a note row is the surface that later grows folding (B12) and colour
        (B15), neither of which a folder row has. Sharing one style now would
        mean splitting it at exactly the moment the first difference lands.
        The visual values are identical today and both come from tokens.

        Every visual value is a semantic token. There is no literal colour,
        size, spacing or radius in this file (ADR-011 rule 1).

        Its states are the shared list-row template in ListRow.xaml, the same
        one FolderRow uses: one template, so the two cannot drift by accident.

        The dictionaries this style consumes are merged HERE (ADR-011 rule 6):
        a resource reference inside a merged dictionary resolves against that
        dictionary and its own merge tree only, never against a sibling merged
        beside it in the parent.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Noto.UI/Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Tokens/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Noto.UI/Styles/ListRow.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="NoteRowStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <!-- The states are the shared list-row template (ListRow.xaml). -->
        <Setter Property="Template" Value="{StaticResource ListRowTemplate}" />
    </Style>

    <!--
        NoteCard: a note in the stack (the visual refresh). A note is a page, not a line, so in the stack it is a card
        raised off the sidebar: its own fill, a subtle edge, the container radius and a step of space below it. Search
        results and the Recycle Bin stay rows (NoteRowStyle): they are lists to scan.

        States, every one in Light, Dark and High Contrast:
          Normal              the card's fill and subtle edge
          PointerOver         the card's hover fill, InteractionText
          Pressed             as PointerOver
          Selected            the card's selected fill, the accent edge, the selected text: in Light and Dark
                              the fill stays the card's, so the note being edited reads as the same page; in high
                              contrast it is Highlight under HighlightText, as a selected row is
          PointerOverSelected as Selected
          PressedSelected     as Selected
          Disabled            disabled text
          Focused             the two-tone ring, keyboard focus only

        A card has no pill: its whole edge takes the accent, which a row has no edge to do.

        Every visual value is a semantic token (ADR-011 rule 1).
    -->
    <ControlTemplate x:Key="NoteCardTemplate" TargetType="ListViewItem">
        <Grid x:Name="Root"
              Background="{ThemeResource SurfaceCardBrush}"
              BorderBrush="{ThemeResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThicknessSubtle}"
              CornerRadius="{StaticResource RadiusMedium}">

            <!--
                The note's colour (F7, #150): a tint over the card's fill, translucent so its hover and selected fills
                still show, and a marker along its leading edge, so a colour is more than a tint. Set by ColorStates.
            -->
            <Border x:Name="ColorTint" CornerRadius="{StaticResource RadiusMedium}" />
            <Border x:Name="ColorMarker"
                    Width="{StaticResource NoteColorMarkerWidth}"
                    Margin="{StaticResource NoteColorMarkerMargin}"
                    HorizontalAlignment="Left"
                    CornerRadius="{StaticResource RadiusNoteColorMarker}" />

            <ContentPresenter x:Name="Content"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextWrapping="NoWrap" />

            <Border x:Name="FocusRing"
                    BorderBrush="{ThemeResource BorderFocusBrush}"
                    BorderThickness="{StaticResource BorderThicknessFocus}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Opacity="0">
                <Border BorderBrush="{ThemeResource BorderFocusInnerBrush}"
                        BorderThickness="{StaticResource BorderThicknessFocusInner}"
                        CornerRadius="{StaticResource RadiusMedium}" />
            </Border>

            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardHoverBrush}" />
                            <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardHoverBrush}" />
                            <Setter Target="Content.Foreground" Value="{ThemeResource InteractionTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardSelectedBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SelectionIndicatorBrush}" />
                            <Setter Target="Content.Foreground" Value="{ThemeResource InteractionSelectedTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerOverSelected">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardSelectedBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SelectionIndicatorBrush}" />
                            <Setter Target="Content.Foreground" Value="{ThemeResource InteractionSelectedTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PressedSelected">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceCardSelectedBrush}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SelectionIndicatorBrush}" />
                            <Setter Target="Content.Foreground" Value="{ThemeResource InteractionSelectedTextBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="DisabledStates">
                    <VisualState x:Name="Enabled" />

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Content.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />

                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerFocused" />
                </VisualStateGroup>

                <VisualStateGroup x:Name="ColorStates">
                    <VisualState x:Name="NoColor" />
                    <VisualState x:Name="Note1">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note1TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note1MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Note2">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note2TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note2MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Note3">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note3TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note3MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Note4">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note4TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note4MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Note5">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note5TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note5MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Note6">
                        <VisualState.Setters>
                            <Setter Target="ColorTint.Background" Value="{ThemeResource Note6TintBrush}" />
                            <Setter Target="ColorMarker.Background" Value="{ThemeResource Note6MarkerBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="NoteCardStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template" Value="{StaticResource NoteCardTemplate}" />
    </Style>

</ResourceDictionary>
