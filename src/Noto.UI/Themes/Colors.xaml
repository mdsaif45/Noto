            text produces halation on OLED panels, and pure black also removes
            the elevation cue a slightly lighter sidebar gives.
        -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SurfaceWindowColor">#1C1C1C</Color>
            <Color x:Key="SurfaceSidebarColor">#202020</Color>

            <Color x:Key="TextPrimaryColor">#F2F2F2</Color>
            <Color x:Key="TextSecondaryColor">#A8A8A8</Color>

            <Color x:Key="BorderSubtleColor">#383838</Color>
            <Color x:Key="BorderFocusColor">#FFFFFF</Color>
            <Color x:Key="BorderFocusInnerColor">#B3000000</Color>

            <Color x:Key="InteractionHoverColor">#2D2D2D</Color>
            <Color x:Key="InteractionSelectedColor">#383838</Color>
            <StaticResource x:Key="InteractionSelectedTextColor" ResourceKey="TextPrimaryColor" />
            <StaticResource x:Key="InteractionTextColor" ResourceKey="TextPrimaryColor" />

            <Color x:Key="SurfaceInputColor">#2D2D2D</Color>
            <Color x:Key="TextDangerColor">#FF99A4</Color>

            <Color x:Key="InteractionPressedColor">#333333</Color>
            <Color x:Key="TextDisabledColor">#767676</Color>

            <StaticResource x:Key="SurfaceCardColor" ResourceKey="SurfaceInputColor" />
            <Color x:Key="SurfaceCardHoverColor">#323232</Color>
            <StaticResource x:Key="SurfaceCardSelectedColor" ResourceKey="SurfaceCardColor" />

            <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{StaticResource SurfaceWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource SurfaceSidebarColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />
            <SolidColorBrush x:Key="BorderFocusInnerBrush" Color="{StaticResource BorderFocusInnerColor}" />
            <SolidColorBrush x:Key="InteractionHoverBrush" Color="{StaticResource InteractionHoverColor}" />
            <SolidColorBrush x:Key="InteractionSelectedBrush" Color="{StaticResource InteractionSelectedColor}" />
            <SolidColorBrush x:Key="InteractionSelectedTextBrush" Color="{StaticResource InteractionSelectedTextColor}" />
            <SolidColorBrush x:Key="InteractionTextBrush" Color="{StaticResource InteractionTextColor}" />
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
            <SolidColorBrush x:Key="TextDangerBrush" Color="{StaticResource TextDangerColor}" />
            <SolidColorBrush x:Key="InteractionPressedBrush" Color="{StaticResource InteractionPressedColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}" />
            <SolidColorBrush x:Key="SurfaceCardSelectedBrush" Color="{StaticResource SurfaceCardSelectedColor}" />

            <StaticResource x:Key="TextControlBackground" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="SurfaceSidebarBrush" />
            <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderSubtleBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="BorderSubtleBrush" />
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="BorderFocusBrush" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="BorderFocusInnerBrush" />
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="InteractionHoverBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="InteractionPressedBrush" />
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SurfaceSidebarBrush" />
            <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderSubtleBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="BorderSubtleBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderSubtleBrush" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="InteractionTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="InteractionTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="InteractionSelectedTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="InteractionSelectedTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="InteractionSelectedTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedUnfocused" ResourceKey="InteractionSelectedTextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="InteractionHoverBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="InteractionPressedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="InteractionSelectedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="InteractionSelectedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="InteractionSelectedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedUnfocused" ResourceKey="InteractionSelectedBrush" />
            <StaticResource x:Key="ToggleSwitchContentForeground" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ToggleSwitchContentForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ToggleSwitchHeaderForeground" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ToggleSwitchHeaderForegroundDisabled" ResourceKey="TextDisabledBrush" />
            <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="SurfaceInputBrush" />
            <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="InteractionHoverColor" />
            <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="InteractionPressedColor" />
            <StaticResource x:Key="ToggleSwitchFillOffDisabled" ResourceKey="SurfaceSidebarColor" />
            <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="TextPrimaryColor" />
            <StaticResource x:Key="ToggleSwitchStrokeOffPressed" ResourceKey="TextPrimaryColor" />
            <StaticResource x:Key="ToggleSwitchStrokeOffDisabled" ResourceKey="TextDisabledColor" />
            <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="TextSecondaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="TextPrimaryBrush" />
            <StaticResource x:Key="ToggleSwitchKnobFillOffDisabled" ResourceKey="TextDisabledBrush" />

            <!-- The editor (ADR-017): a link's text, and the surface behind inline and fenced code. -->
            <Color x:Key="TextLinkColor">#8CC2FF</Color>
            <Color x:Key="SurfaceCodeColor">#3A3A3A</Color>
            <SolidColorBrush x:Key="TextLinkBrush" Color="{StaticResource TextLinkColor}" />
            <SolidColorBrush x:Key="SurfaceCodeBrush" Color="{StaticResource SurfaceCodeColor}" />

            <!-- Search (ADR-018): a matched word start, marked behind its text. Text on it measures 6.8:1. -->
            <Color x:Key="SearchMatchColor">#6B5A00</Color>
            <Color x:Key="SearchMatchTextColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="SearchMatchBrush" Color="{StaticResource SearchMatchColor}" />
            <SolidColorBrush x:Key="SearchMatchTextBrush" Color="{StaticResource SearchMatchTextColor}" />

            <!--
                The note palette (F7, #150; ADR-011). Dark tints are fainter than light ones: a brighter hue lifts the
                card under the secondary text, which must keep 4.5:1 (DesignSystemGuardTests).
            -->
            <Color x:Key="Note1TintColor">#14F5C400</Color>
            <Color x:Key="Note1MarkerColor">#F5C400</Color>
            <Color x:Key="Note2TintColor">#1C3FB950</Color>
            <Color x:Key="Note2MarkerColor">#3FB950</Color>
            <Color x:Key="Note3TintColor">#213A96F5</Color>
            <Color x:Key="Note3MarkerColor">#3A96F5</Color>
            <Color x:Key="Note4TintColor">#21A371F7</Color>
            <Color x:Key="Note4MarkerColor">#A371F7</Color>
            <Color x:Key="Note5TintColor">#1FEC6CB0</Color>
            <Color x:Key="Note5MarkerColor">#EC6CB0</Color>
            <Color x:Key="Note6TintColor">#1F8B949E</Color>
            <Color x:Key="Note6MarkerColor">#8B949E</Color>
            <SolidColorBrush x:Key="Note1TintBrush" Color="{StaticResource Note1TintColor}" />
            <SolidColorBrush x:Key="Note1MarkerBrush" Color="{StaticResource Note1MarkerColor}" />
            <SolidColorBrush x:Key="Note2TintBrush" Color="{StaticResource Note2TintColor}" />
            <SolidColorBrush x:Key="Note2MarkerBrush" Color="{StaticResource Note2MarkerColor}" />
            <SolidColorBrush x:Key="Note3TintBrush" Color="{StaticResource Note3TintColor}" />
            <SolidColorBrush x:Key="Note3MarkerBrush" Color="{StaticResource Note3MarkerColor}" />
            <SolidColorBrush x:Key="Note4TintBrush" Color="{StaticResource Note4TintColor}" />
            <SolidColorBrush x:Key="Note4MarkerBrush" Color="{StaticResource Note4MarkerColor}" />
            <SolidColorBrush x:Key="Note5TintBrush" Color="{StaticResource Note5TintColor}" />
            <SolidColorBrush x:Key="Note5MarkerBrush" Color="{StaticResource Note5MarkerColor}" />
            <SolidColorBrush x:Key="Note6TintBrush" Color="{StaticResource Note6TintColor}" />
            <SolidColorBrush x:Key="Note6MarkerBrush" Color="{StaticResource Note6MarkerColor}" />
        </ResourceDictionary>

        <!--
            HIGH CONTRAST. Every value comes from the system, because the point
            of the mode is that the USER chose the palette. Hardcoding even one
            "accessible" colour here would override that choice.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SurfaceWindowColor" ResourceKey="SystemColorWindowColor" />
