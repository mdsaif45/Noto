<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPIKE — throwaway. Not production code, not referenced by src/, not in Noto.sln.
    Answers #246: can an unpackaged, self-contained WinUI 3 app print a note through Windows' print dialog
    (PrintManagerInterop + Microsoft.UI.Xaml.Printing.PrintDocument), keeping its headings, lists, tasks and pictures?

    Same shape as the app (Noto.Windows.csproj): net9, unpackaged, self-contained, and ADR-008's reduced set of
    Windows App SDK 2.6.5 parts, so a pass here is a pass for Noto's own footprint. It parses with Noto.Core's
    MarkdownDocument, the parse the read view renders from.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Noto.Spike.Print</RootNamespace>
    <AssemblyName>Noto.Spike.Print</AssemblyName>
    <!-- A spike, not held to production standards (spikes/README.md). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Noto.Core\Noto.Core.csproj" />
  </ItemGroup>

</Project>
