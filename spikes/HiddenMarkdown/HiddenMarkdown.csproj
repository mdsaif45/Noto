<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPIKE — throwaway. Not production code, not referenced by src/, not in Noto.sln.
    Answers Phase C's design gate (P2.0): can a RichEditBox show markdown with its markup hidden while the document
    text stays the markdown source, within budget, with sane undo, caret and UI Automation behaviour?

    Same shape as the app (Noto.Windows.csproj): net9, unpackaged, self-contained, and the centrally pinned
    Windows App SDK, so the numbers are the app's.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Noto.Spike.HiddenMarkdown</RootNamespace>
    <AssemblyName>Noto.Spike.HiddenMarkdown</AssemblyName>
    <!-- A spike, not held to production standards (spikes/README.md). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

</Project>
